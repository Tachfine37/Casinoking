{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "outputDirectory": "artifacts/casino-blog/dist/public",
  "env": {
    "PORT": "3000",
    "BASE_PATH": "/",
    "VITE_API_URL": "@vite_api_url"
  },
  "envPrefix": [
    "VITE_"
  ],
  "rewrites": [
    {
      "source": "/:path((?!api|_next|_static|.*\\..*|.*\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
